{
  "name": "deskbuddy",
  "version": "1.0.0",
  "description": "3D desktop companion with marketplace",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:appx": "electron-builder --win appx",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.yuvexel.deskbuddy",
    "productName": "DeskBuddy",
    "copyright": "© 2026 Yuvexel",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "node_modules/three/examples/jsm/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "portable": {
      "artifactName": "DeskBuddy-Portable-${version}.exe"
    },
    "appx": {
      "applicationId": "DeskBuddy",
      "identityName": "REPLACE_WITH_PARTNER_CENTER_IDENTITY_NAME",
      "publisher": "CN=REPLACE_WITH_PARTNER_CENTER_PUBLISHER_ID",
      "publisherDisplayName": "Yuvexel",
      "backgroundColor": "#05060a",
      "showNameOnTiles": true,
      "languages": [
        "en-US"
      ],
      "artifactName": "DeskBuddy-${version}.appx"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/icon.png"
    }
  },
  "keywords": [],
  "author": "Yuvexel",
  "license": "ISC",
  "dependencies": {
    "@pixiv/three-vrm": "^3.5.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  }
}
